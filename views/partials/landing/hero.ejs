<!-- SECTION 01 — HERO -->
<section class="ph-hero" id="hero">
  <!-- Background Glow & Mesh Atmosphere -->
  <div class="ph-hero-ambient-glow"></div>
  <div class="ph-hero-radial-grid"></div>

  <div class="ph-hero-inner">
    <!-- Left Hero Typography & Actions -->
    <div class="ph-hero-content">
      <div class="ph-hero-badge" data-hero-el="badge">
        <span class="ph-badge-pulse"></span>
        <span class="ph-badge-label">PHOENIX</span>
      </div>

      <h1 class="ph-hero-heading" data-hero-el="heading">
        <span class="ph-headline-row"><span class="ph-word">YOUR</span> <span class="ph-word">SKILLS.</span></span>
        <span class="ph-headline-row"><span class="ph-word ph-gradient-text">DESERVE</span> <span class="ph-word ph-gradient-text">MORE.</span></span>
      </h1>

      <p class="ph-hero-tagline" data-hero-el="tagline">
        Your skills deserve more than a classroom.
      </p>

      <p class="ph-hero-desc" data-hero-el="desc">
        Phoenix is the premier student collaboration network where you turn your skills into real projects, real experience, and real opportunities.
      </p>

      <div class="ph-hero-ctas" data-hero-el="cta">
        <a href="/register" class="ph-btn ph-btn-lg ph-btn-primary ph-btn-glow">
          <span>Join Phoenix</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7H7M17 7V17"/></svg>
        </a>
        <a href="#about" class="ph-btn ph-btn-lg ph-btn-secondary ph-scroll-link">
          <span>Explore The Network</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Quick Trust Metric Row -->
      <div class="ph-hero-trust" data-hero-el="trust">
        <div class="ph-trust-item">
          <span class="ph-trust-num">100%</span>
          <span class="ph-trust-lbl">Student Driven</span>
        </div>
        <div class="ph-trust-sep"></div>
        <div class="ph-trust-item">
          <span class="ph-trust-num">PREMIER</span>
          <span class="ph-trust-lbl">Campus Ecosystem</span>
        </div>
        <div class="ph-trust-sep"></div>
        <div class="ph-trust-item">
          <span class="ph-trust-num">8+</span>
          <span class="ph-trust-lbl">Active Domains</span>
        </div>
      </div>
    </div>

    <!-- Right 3D Globe Network Centerpiece -->
    <div class="ph-hero-visual" data-hero-el="globe">
      <div class="ph-globe-wrapper" id="phGlobeContainer">
        <canvas id="phGlobeCanvas"></canvas>
        <div class="ph-globe-fallback" id="phGlobeFallback">
          <div class="ph-fallback-core">
            <div class="ph-fallback-ring ph-ring-1"></div>
            <div class="ph-fallback-ring ph-ring-2"></div>
            <div class="ph-fallback-ring ph-ring-3"></div>
            <div class="ph-fallback-hub">PHOENIX</div>
          </div>
        </div>

        <!-- Floating Interactive Node Badges (Orchestrated by JS) -->
        <div class="ph-floating-node node-rahul" data-node="rahul">
          <span class="node-dot"></span>
          <div class="node-meta">
            <span class="node-name">Rahul</span>
            <span class="node-skill">WEB DEV</span>
          </div>
        </div>

        <div class="ph-floating-node node-rishabh" data-node="rishabh">
          <span class="node-dot"></span>
          <div class="node-meta">
            <span class="node-name">Rishabh</span>
            <span class="node-skill">AI / ML</span>
          </div>
        </div>

        <div class="ph-floating-node node-priya" data-node="priya">
          <span class="node-dot"></span>
          <div class="node-meta">
            <span class="node-name">Priya</span>
            <span class="node-skill">UI / UX</span>
          </div>
        </div>

        <div class="ph-floating-node node-aman" data-node="aman">
          <span class="node-dot"></span>
          <div class="node-meta">
            <span class="node-name">Aman</span>
            <span class="node-skill">VIDEO EDITING</span>
          </div>
        </div>

        <div class="ph-floating-node node-aarav" data-node="aarav">
          <span class="node-dot"></span>
          <div class="node-meta">
            <span class="node-name">Aarav</span>
            <span class="node-skill">APP DEV</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <a href="#about" class="ph-scroll-indicator" aria-label="Scroll to about section">
    <span class="ph-scroll-text">SCROLL</span>
    <span class="ph-scroll-arrow">↓</span>
  </a>
</section>
