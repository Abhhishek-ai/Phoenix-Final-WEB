<!-- PHOENIX Floating Glassmorphic Navbar -->
<header class="ph-navbar" id="phNavbar">
  <div class="ph-nav-container">
    <a href="/" class="ph-brand" aria-label="PHOENIX Home">
      <div class="ph-brand-logo">
        <img src="/images/logo.jpg" alt="PHOENIX Logo">
      </div>
      <div class="ph-brand-info">
        <span class="ph-brand-name">PHOENIX</span>
      </div>
    </a>

    <nav class="ph-nav-links" id="phNavLinks" aria-label="Main Navigation">
      <a href="#about" class="ph-nav-item">About</a>
      <a href="#story" class="ph-nav-item">Story</a>
      <a href="#team" class="ph-nav-item">Team</a>
      <a href="#skills" class="ph-nav-item">Skills</a>
      <a href="#how-it-works" class="ph-nav-item">How It Works</a>
      <a href="/portfolio" class="ph-nav-item ph-nav-accent">Showcase</a>
    </nav>

    <div class="ph-nav-actions">
      <!-- Dark / Light Theme Toggle Button -->
      <button class="ph-theme-toggle" id="phThemeToggle" aria-label="Toggle Light and Dark Mode" title="Toggle Theme">
        <svg class="ph-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="ph-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>

      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.role === 'ADMIN') { %>
          <a href="/admin/dashboard" class="ph-btn ph-btn-sm ph-btn-outline">Admin Portal</a>
        <% } else if (user.role === 'FREELANCER') { %>
          <a href="/freelancer/dashboard" class="ph-btn ph-btn-sm ph-btn-outline">Dashboard</a>
        <% } else if (user.role === 'CLIENT') { %>
          <a href="/client/dashboard" class="ph-btn ph-btn-sm ph-btn-outline">Client Hub</a>
        <% } %>
        <form action="/logout" method="POST" class="ph-logout-inline">
          <button type="submit" class="ph-btn ph-btn-sm ph-btn-ghost" title="Logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="ph-nav-login">Login</a>
        <a href="/register" class="ph-btn ph-btn-sm ph-btn-primary">
          <span>Join Phoenix</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
        </a>
      <% } %>

      <!-- Mobile Hamburger Toggle -->
      <button class="ph-mobile-toggle" id="phMobileToggle" aria-label="Toggle mobile menu" aria-expanded="false">
        <span class="ph-toggle-bar"></span>
        <span class="ph-toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="ph-mobile-drawer" id="phMobileDrawer">
    <div class="ph-mobile-menu-inner">
      <a href="#about" class="ph-mob-link">About</a>
      <a href="#story" class="ph-mob-link">Story</a>
      <a href="#team" class="ph-mob-link">Team</a>
      <a href="#skills" class="ph-mob-link">Skills</a>
      <a href="#how-it-works" class="ph-mob-link">How It Works</a>
      <a href="/portfolio" class="ph-mob-link">Project Showcase</a>
      <div class="ph-mob-divider"></div>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="<%= user.role === 'ADMIN' ? '/admin/dashboard' : (user.role === 'CLIENT' ? '/client/dashboard' : '/freelancer/dashboard') %>" class="ph-btn ph-btn-primary ph-btn-full">Go to Dashboard</a>
        <form action="/logout" method="POST" class="ph-mob-logout-form">
          <button type="submit" class="ph-btn ph-btn-ghost ph-btn-full">Logout</button>
        </form>
      <% } else { %>
        <a href="/login" class="ph-btn ph-btn-outline ph-btn-full">Login</a>
        <a href="/register" class="ph-btn ph-btn-primary ph-btn-full">Join Phoenix ↗</a>
      <% } %>
    </div>
  </div>
</header>
