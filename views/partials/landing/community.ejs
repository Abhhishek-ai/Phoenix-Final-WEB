<!-- SECTION 08 — COMMUNITY & METRICS -->
<section class="ph-section ph-community-section" id="community">
  <div class="ph-container">
    <div class="ph-section-header">
      <span class="ph-section-eyebrow">COMMUNITY & SCALE</span>
      <h2 class="ph-section-title">
        YOU'RE NOT <span class="ph-gradient-text">BUILDING ALONE.</span>
      </h2>
      <p class="ph-section-sub">
        Join a vibrant network of over a hundred student builders across MBM University engineering disciplines.
      </p>
    </div>

    <div class="ph-stats-grid">
      <!-- Stat 01: Members -->
      <div class="ph-stat-box" data-reveal="scale-up">
        <div class="ph-stat-icon">👥</div>
        <div class="ph-stat-val-group">
          <span class="ph-counter" data-target="<%= typeof stats !== 'undefined' ? stats.members : 120 %>">0</span>
          <span class="ph-counter-plus">+</span>
        </div>
        <span class="ph-stat-name">STUDENT CREATORS</span>
        <p class="ph-stat-desc">Active developers, designers & writers across campus</p>
      </div>

      <!-- Stat 02: Projects -->
      <div class="ph-stat-box" data-reveal="scale-up" data-delay="100">
        <div class="ph-stat-icon">💼</div>
        <div class="ph-stat-val-group">
          <span class="ph-counter" data-target="<%= typeof stats !== 'undefined' ? stats.projects : 35 %>">0</span>
          <span class="ph-counter-plus">+</span>
        </div>
        <span class="ph-stat-name">PROJECTS POSTED</span>
        <p class="ph-stat-desc">Real projects, web apps & campus initiatives</p>
      </div>

      <!-- Stat 03: Domains -->
      <div class="ph-stat-box" data-reveal="scale-up" data-delay="200">
        <div class="ph-stat-icon">⚡</div>
        <div class="ph-stat-val-group">
          <span class="ph-counter" data-target="<%= typeof stats !== 'undefined' ? stats.domains : 8 %>">0</span>
          <span class="ph-counter-plus"></span>
        </div>
        <span class="ph-stat-name">SPECIALIZED DOMAINS</span>
        <p class="ph-stat-desc">From Web & AI to UI/UX, Video & Technical Writing</p>
      </div>

      <!-- Stat 04: Completed -->
      <div class="ph-stat-box" data-reveal="scale-up" data-delay="300">
        <div class="ph-stat-icon">🏆</div>
        <div class="ph-stat-val-group">
          <span class="ph-counter" data-target="<%= typeof stats !== 'undefined' ? stats.completed : 28 %>">0</span>
          <span class="ph-counter-plus">+</span>
        </div>
        <span class="ph-stat-name">PROJECTS DELIVERED</span>
        <p class="ph-stat-desc">Verified completed contracts with 5-star client ratings</p>
      </div>
    </div>
  </div>
</section>
