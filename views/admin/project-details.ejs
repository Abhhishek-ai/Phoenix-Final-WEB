<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Project Details | PHOENIX Admin' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
  <%- include('../partials/admin-navbar') %>

  <div class="dashboard-layout">
    <%- include('../partials/admin-sidebar') %>

    <main class="dashboard-content">
      <div class="dashboard-container">
        <!-- Back Navigation & Status Pill -->
        <div class="details-top-bar">
          <a href="/admin/projects" class="btn btn-outline btn-sm">&larr; Back to Projects Directory</a>
          <span class="status-badge status-badge-<%= project.status ? project.status.toLowerCase() : 'open' %> status-badge-lg">
            Status: <%= project.status %>
          </span>
        </div>

        <!-- Flash Messages -->
        <div class="admin-flash-container">
          <%- include('../partials/flash') %>
        </div>

        <!-- Hero Header -->
        <div class="profile-hero-card">
          <div>
            <span class="domain-tag-sm" style="margin-bottom: 0.5rem; display: inline-block;">
              <%= project.category ? project.category.replace('_', ' ') : 'General' %>
            </span>
            <h1 class="profile-hero-name"><%= project.title %></h1>
            <p class="profile-hero-meta">
              <span>📅 Created: <%= new Date(project.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              <span>&bull;</span>
              <span>👤 Published by: <%= project.createdBy ? project.createdBy.name : 'Administrator' %></span>
            </p>
          </div>

          <!-- Actions -->
          <div class="profile-action-controls">
            <a href="/admin/projects/<%= project._id %>/bids" class="btn btn-primary btn-md">
              🏷️ View Proposals (<%= totalBids || 0 %>)
            </a>

            <% if (project.status === 'OPEN') { %>
              <form action="/admin/projects/<%= project._id %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="status" value="CANCELLED">
                <button type="submit" class="btn btn-danger btn-md" onclick="return confirm('Are you sure you want to cancel this project listing?')">
                  ✕ Cancel Project
                </button>
              </form>
            <% } else if (project.status === 'CANCELLED') { %>
              <form action="/admin/projects/<%= project._id %>/status" method="POST" style="display:inline;">
                <input type="hidden" name="status" value="OPEN">
                <button type="submit" class="btn btn-success btn-md" onclick="return confirm('Reopen this project for freelancer bidding?')">
                  ✓ Reopen Project
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <!-- Project Details Grid -->
        <div class="details-grid-2">
          <!-- Left Column: Scope & Description -->
          <div class="details-column">
            <div class="admin-section-card">
              <h3 class="panel-title">Project Scope & Deliverables</h3>
              <div class="project-full-desc">
                <p style="white-space: pre-wrap; line-height: 1.7;"><%= project.description %></p>
              </div>
            </div>

            <!-- Required Skills -->
            <div class="admin-section-card">
              <h3 class="panel-title">Required Skills & Technologies</h3>
              <% if (project.requiredSkills && project.requiredSkills.length > 0) { %>
                <div class="skills-tag-group">
                  <% project.requiredSkills.forEach(function(skill) { %>
                    <span class="skill-tag">
                      <%= typeof skill === 'object' && skill.name ? skill.name : skill %>
                    </span>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-muted"><em>Open to all skill sets.</em></p>
              <% } %>
            </div>
          </div>

          <!-- Right Column: Specs & Assignment Status -->
          <div class="details-column">
            <div class="admin-section-card">
              <h3 class="panel-title">Project Specifications</h3>
              <div class="info-list">
                <div class="info-item">
                  <span class="info-label">Budget Range</span>
                  <span class="info-value mono-text" style="color: var(--accent-emerald); font-weight: 700;">
                    ₹<%= project.budget && project.budget.min ? project.budget.min.toLocaleString('en-IN') : '0' %> - ₹<%= project.budget && project.budget.max ? project.budget.max.toLocaleString('en-IN') : '0' %>
                  </span>
                </div>
                <div class="info-item">
                  <span class="info-label">Submission Deadline</span>
                  <span class="info-value">
                    ⏱️ <%= new Date(project.deadline).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </span>
                </div>
                <div class="info-item">
                  <span class="info-label">Domain Track</span>
                  <span class="info-value"><%= project.category ? project.category.replace('_', ' ') : 'General' %></span>
                </div>
                <div class="info-item">
                  <span class="info-label">Total Submitted Bids</span>
                  <span class="info-value">
                    <a href="/admin/projects/<%= project._id %>/bids" class="bids-count-pill <%= totalBids > 0 ? 'has-bids' : '' %>">
                      <%= totalBids || 0 %> Bids Received &rarr;
                    </a>
                  </span>
                </div>
              </div>
            </div>

            <!-- Assignment Info Box (If Assigned) -->
            <% if (project.status === 'ASSIGNED' || assignment) { %>
              <div class="admin-section-card" style="border-color: rgba(16, 185, 129, 0.4); background: linear-gradient(135deg, rgba(16, 185, 129, 0.06), var(--bg-secondary));">
                <h3 class="panel-title" style="color: #34d399;">✓ Project Assignment Details</h3>
                <div class="info-list">
                  <div class="info-item">
                    <span class="info-label">Assigned Freelancer</span>
                    <span class="info-value">
                      <% if (assignment && assignment.freelancerId) { %>
                        <strong><%= assignment.freelancerId.name %></strong> (<%= assignment.freelancerId.email %>)
                      <% } else if (project.selectedBid && project.selectedBid.freelancerId) { %>
                        <strong><%= project.selectedBid.freelancerId.name %></strong>
                      <% } else { %>
                        Assigned
                      <% } %>
                    </span>
                  </div>
                  <% if (assignment) { %>
                    <div class="info-item">
                      <span class="info-label">Assigned By</span>
                      <span class="info-value"><%= assignment.assignedBy ? assignment.assignedBy.name : 'Admin' %></span>
                    </div>
                    <div class="info-item">
                      <span class="info-label">Assignment Start</span>
                      <span class="info-value"><%= new Date(assignment.startDate).toLocaleDateString('en-IN') %></span>
                    </div>
                    <div class="info-item">
                      <span class="info-label">Current Progress</span>
                      <span class="info-value">
                        <div class="progress-bar-container">
                          <div class="progress-bar-fill" style="width: <%= assignment.progress || 0 %>%;"></div>
                        </div>
                        <span class="progress-text"><%= assignment.progress || 0 %>%</span>
                      </span>
                    </div>
                  <% } %>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
