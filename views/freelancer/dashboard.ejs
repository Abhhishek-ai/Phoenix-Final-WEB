<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Freelancer Dashboard | PHOENIX' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
  <%- include('../partials/freelancer-navbar') %>

  <div class="dashboard-layout">
    <%- include('../partials/freelancer-sidebar') %>

    <main class="dashboard-content">
      <div class="dashboard-container">
        <!-- Header -->
        <div class="page-header-row">
          <div>
            <h1 class="page-main-title">Student Freelancer Hub</h1>
            <p class="page-main-subtitle">Welcome back, <%= user.name %>! Explore live projects and track your ongoing assignments.</p>
          </div>
          <div class="page-header-actions">
            <a href="/freelancer/projects" class="btn btn-primary btn-sm">
              🔍 Explore Marketplace
            </a>
          </div>
        </div>

        <!-- Flash Messages -->
        <div class="admin-flash-container">
          <%- include('../partials/flash') %>
        </div>

        <!-- Stats Cards Grid -->
        <div class="stats-grid">
          <div class="admin-stat-card">
            <div class="stat-card-header">
              <span class="stat-card-title">Active Projects</span>
              <span class="stat-icon-badge active-badge">💼</span>
            </div>
            <div class="stat-card-value"><%= stats.activeProjects %></div>
            <p class="stat-card-meta">
              <a href="/freelancer/assignments" class="stat-card-link">View assignments &rarr;</a>
            </p>
          </div>

          <div class="admin-stat-card">
            <div class="stat-card-header">
              <span class="stat-card-title">Pending Proposals</span>
              <span class="stat-icon-badge pending-badge">⏳</span>
            </div>
            <div class="stat-card-value"><%= stats.pendingBids %></div>
            <p class="stat-card-meta">
              <a href="/freelancer/bids?status=PENDING" class="stat-card-link">Track bids &rarr;</a>
            </p>
          </div>

          <div class="admin-stat-card">
            <div class="stat-card-header">
              <span class="stat-card-title">Completed Projects</span>
              <span class="stat-icon-badge active-badge">🏆</span>
            </div>
            <div class="stat-card-value"><%= stats.completedProjects %></div>
            <p class="stat-card-meta">Delivered milestones</p>
          </div>
        </div>

        <!-- Active Assignments Section -->
        <div class="admin-section-card">
          <div class="section-card-header">
            <div>
              <h2 class="section-card-title">My Current Project Assignments</h2>
              <p class="section-card-subtitle">Projects assigned to you by administrators and campus coordinators</p>
            </div>
            <a href="/freelancer/assignments" class="btn btn-secondary btn-sm">View All Assignments</a>
          </div>

          <% if (typeof activeAssignments !== 'undefined' && activeAssignments.length > 0) { %>
            <div class="table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Project</th>
                    <th>Domain</th>
                    <th>Deadline</th>
                    <th>Progress</th>
                    <th>Status</th>
                    <th class="text-right">Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% activeAssignments.forEach(function(a) { %>
                    <tr>
                      <td>
                        <strong><%= a.projectId ? a.projectId.title : 'Project' %></strong>
                      </td>
                      <td>
                        <span class="domain-tag-sm">
                          <%= a.projectId && a.projectId.category ? a.projectId.category.replace('_', ' ') : 'General' %>
                        </span>
                      </td>
                      <td><%= a.deadline ? new Date(a.deadline).toLocaleDateString('en-IN') : 'N/A' %></td>
                      <td>
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                          <div class="progress-bar-container" style="width: 80px;">
                            <div class="progress-bar-fill" style="width: <%= a.progress || 0 %>%;"></div>
                          </div>
                          <span class="progress-text"><%= a.progress || 0 %>%</span>
                        </div>
                      </td>
                      <td>
                        <span class="status-badge status-badge-<%= a.status ? a.status.toLowerCase() : 'assigned' %>">
                          <%= a.status %>
                        </span>
                      </td>
                      <td class="text-right">
                        <a href="/freelancer/projects/<%= a.projectId ? a.projectId._id : '' %>" class="btn btn-secondary btn-xs">
                          Project Brief &rarr;
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">
              <span class="empty-state-icon">📋</span>
              <h3>No Active Assignments Right Now</h3>
              <p>Explore open projects in the marketplace and submit proposals to get assigned.</p>
              <div style="margin-top: 1rem;">
                <a href="/freelancer/projects" class="btn btn-primary btn-sm">Browse Open Projects</a>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Latest Open Projects in Marketplace -->
        <div class="admin-section-card">
          <div class="section-card-header">
            <div>
              <h2 class="section-card-title">Live Marketplace Projects</h2>
              <p class="section-card-subtitle">Fresh freelance gigs open for proposals from MBM students</p>
            </div>
            <a href="/freelancer/projects" class="btn btn-secondary btn-sm">Browse All Marketplace</a>
          </div>

          <% if (typeof recentOpenProjects !== 'undefined' && recentOpenProjects.length > 0) { %>
            <div class="projects-market-grid">
              <% recentOpenProjects.forEach(function(project) { %>
                <%- include('../partials/project-card', { project: project }) %>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state">
              <span class="empty-state-icon">💼</span>
              <h3>No Projects Available Right Now</h3>
              <p>Check back soon for new project postings by campus coordinators and clients.</p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
