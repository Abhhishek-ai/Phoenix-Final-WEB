<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Add Portfolio Project | PHOENIX' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="dashboard-body">
  <%- include('../partials/freelancer-navbar') %>

  <div class="dashboard-layout">
    <%- include('../partials/freelancer-sidebar') %>

    <main class="dashboard-content">
      <div class="dashboard-container">
        <!-- Header -->
        <div class="page-header-row">
          <div>
            <h1 class="page-main-title">Add Portfolio Project</h1>
            <p class="page-main-subtitle">Submit your best engineering or creative work to be showcased on PHOENIX</p>
          </div>
          <div>
            <a href="/freelancer/portfolio" class="btn btn-secondary btn-sm">&larr; Back to Portfolio</a>
          </div>
        </div>

        <!-- Flash Messages -->
        <div class="admin-flash-container">
          <%- include('../partials/flash') %>
        </div>

        <!-- Form Card -->
        <div class="admin-section-card form-card-max">
          <form action="/freelancer/portfolio" method="POST" enctype="multipart/form-data" class="project-form" novalidate>
            <!-- Title -->
            <div class="form-group">
              <label for="title" class="form-label">Project Title <span class="required">*</span></label>
              <input type="text" id="title" name="title" class="form-control" placeholder="e.g. MBM AI Automated Timetable Scheduler" required>
            </div>

            <!-- Category -->
            <div class="form-group">
              <label for="category" class="form-label">Domain Track <span class="required">*</span></label>
              <select id="category" name="category" class="form-control form-select" required>
                <option value="">Select Category</option>
                <% categories.forEach(function(cat) { %>
                  <option value="<%= cat %>"><%= cat.replace('_', ' ') %></option>
                <% }); %>
              </select>
            </div>

            <!-- Description -->
            <div class="form-group">
              <label for="description" class="form-label">Project Description & Architecture <span class="required">*</span></label>
              <textarea id="description" name="description" rows="5" class="form-control" placeholder="Describe the problem, tech stack, and impact of this project..." required></textarea>
            </div>

            <!-- Links -->
            <div class="form-grid-2">
              <div class="form-group">
                <label for="projectLink" class="form-label">Live Demo / App URL</label>
                <input type="url" id="projectLink" name="projectLink" class="form-control" placeholder="https://myproject.com">
              </div>

              <div class="form-group">
                <label for="githubLink" class="form-label">GitHub Repository URL</label>
                <input type="url" id="githubLink" name="githubLink" class="form-control" placeholder="https://github.com/username/repo">
              </div>
            </div>

            <!-- Screenshot Images -->
            <div class="form-group">
              <label for="images" class="form-label">Project Screenshots / Images (Up to 4 images)</label>
              <div class="file-upload-dropzone" style="padding: 1.5rem;">
                <input type="file" id="images" name="images" class="file-input-control" multiple accept="image/png,image/jpeg,image/webp">
                <div class="dropzone-hint">
                  <span style="font-size: 1.5rem; display: block;">🖼️</span>
                  <strong>Click or drag images here (JPG, PNG, WEBP)</strong>
                </div>
              </div>
            </div>

            <!-- Skills -->
            <div class="form-group">
              <label class="form-label">Technologies Used</label>
              <div class="skills-checkbox-grid" style="max-height: 180px;">
                <% skills.forEach(function(skill) { %>
                  <label class="skill-checkbox-item">
                    <input type="checkbox" name="skills" value="<%= skill._id %>">
                    <span class="skill-checkbox-label"><%= skill.name %></span>
                  </label>
                <% }); %>
              </div>
            </div>

            <div class="form-actions-row">
              <button type="submit" class="btn btn-primary btn-lg">
                🚀 Submit for Coordinator Review
              </button>
              <a href="/freelancer/portfolio" class="btn btn-secondary btn-lg">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
