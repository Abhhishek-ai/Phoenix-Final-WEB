# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/phoenix

# Session Configuration
SESSION_SECRET=phoenix_mbm_secret_key_change_in_production
SESSION_MAX_AGE_DAYS=7

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin Accounts (For seed/admins.js)
ADMIN1_EMAIL=admin1@mbm.ac.in
ADMIN1_PASSWORD=AdminPass123!

ADMIN2_EMAIL=admin2@mbm.ac.in
ADMIN2_PASSWORD=AdminPass123!

ADMIN3_EMAIL=admin3@mbm.ac.in
ADMIN3_PASSWORD=AdminPass123!
